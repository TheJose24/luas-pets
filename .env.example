# Copiar a .env y completar localmente; nunca subir valores reales.
DB_NAME=luas_pets
DB_USER=luaspets_app

# Generar valores distintos y seguros para ambas contraseñas.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

JAVA_OPTS=-Xms256m -Xmx512m

# Obligatoria: generar una vez con openssl rand -base64 32 y conservarla.
# No rotarla después de habilitar MFA sin una migración de secretos TOTP.
TOTP_ENCRYPTION_KEY=BASE64_DE_32_BYTES
